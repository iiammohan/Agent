# Copy to .env and fill in, or export in your shell. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: where your data lives (default ~/.futureyou)
# FUTUREYOU_HOME=

# Optional: route through OpenRouter's Anthropic-compatible endpoint instead.
# Uses an OpenRouter key; note your entries then pass through OpenRouter too.
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_API_KEY=sk-or-...
# FUTUREYOU_MODEL=anthropic/claude-opus-5
