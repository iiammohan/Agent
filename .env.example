# Copy to .env and fill in, or export in your shell. Never commit .env.

# Option A: Anthropic direct (Claude models). Needs a Developer Platform account.
ANTHROPIC_API_KEY=

# Option B: OpenRouter, any model they list. Used automatically when only this key is set.
# OPENROUTER_API_KEY=sk-or-...
# FUTUREYOU_MODEL=anthropic/claude-opus-5     # or openai/gpt-5, google/gemini-2.5-pro, ...

# Force the provider when both keys are set: anthropic | openrouter
# FUTUREYOU_PROVIDER=

# Where your data lives (default ~/.futureyou)
# FUTUREYOU_HOME=
